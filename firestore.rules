rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verifica si el usuario autenticado está en la lista de adminEmails
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email in
          get(/databases/$(database)/documents/config/app).data.adminEmails;
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    // Usuario lee/escribe solo su propio doc. Admin puede leer todos (selector).
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && request.auth.uid == uid;

      // Subcolecciones: solo lectura propia. Functions escriben via Admin SDK.
      match /{subcollection}/{docId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // ── KITS / CATÁLOGO ──────────────────────────────────────────────────────
    // Lectura pública. Admin puede actualizar (toggle isActive, stock).
    // Create/delete solo via Admin SDK (seed script y functions).
    match /kits/{kitId} {
      allow read: if true;
      allow update: if isAdmin();
      allow create, delete: if false;
    }

    // ── ÓRDENES ──────────────────────────────────────────────────────────────
    // Cada usuario solo ve sus propias órdenes.
    // Creación y actualización exclusivas de Functions.
    match /orders/{orderId} {
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ── ENTREGAS DE RECICLAJE ────────────────────────────────────────────────
    // Solo accesibles por Functions (Admin SDK omite estas reglas).
    // El front NUNCA lee ni escribe aquí directamente.
    match /recyclingDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    // ── CURSOS ───────────────────────────────────────────────────────────────
    // Lectura para usuarios autenticados.
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Las preguntas con respuestas correctas NUNCA llegan al front.
      match /questions/{questionId} {
        allow read, write: if false;
      }
    }

    // ── GAME DATA ────────────────────────────────────────────────────────────
    // Estado del juego: puntos, skin, items equipados, historial.
    // Usuario lee y escribe solo su propio doc. Functions escriben via Admin SDK.
    match /gameData/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── TIENDA ───────────────────────────────────────────────────────────────
    match /shopItems/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── REFERIDOS ────────────────────────────────────────────────────────────
    // Lectura para validar un código al ingresarlo; escritura solo Functions.
    match /referralCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // ── CONFIG ───────────────────────────────────────────────────────────────
    // El front lee config/app para: check de admin y pointsPerGram.
    // Admin puede actualizar config/app (pointsPerGram, etc).
    // Create/delete solo via seed script (Admin SDK).
    match /config/{docId} {
      allow read: if request.auth != null;
      allow update: if isAdmin() && docId == "app";
      allow create, delete: if false;
    }

    // ── DENEGADO POR DEFECTO ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
